<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://local.frame-home/app" version="0.7.0" viewmodes="maximized">
  <!-- Installation floor; device-specific evidence is recorded in docs/compatibility.md. -->
  <tizen:application id="nClrkHome1.FrameHome" package="nClrkHome1" required_version="5.0"/>
  <content src="index.html"/>
  <name>CleanTV</name>
  <icon src="icon.png"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <tizen:profile name="tv-samsung"/>
  <!-- Overlay/transparent support (as Samsung's own Home uses) so the launcher renders as a
       popover over live content. Honoured on Tizen 6.0 AU8000; harmless where unsupported. -->
  <tizen:metadata key="http://samsung.com/tv/metadata/transparent.support" value="true"/>
  <tizen:metadata key="http://samsung.com/tv/metadata/partial.overlay.support" value="true"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
  <!-- Saved antenna channels dock: channel list lookup and tuning. -->
  <tizen:privilege name="http://tizen.org/privilege/tv.channel"/>
  <!-- Home weather: approximate location by IP and the Open-Meteo forecast only. -->
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <access origin="https://ipwho.is" subdomains="false"/>
  <access origin="https://ipapi.co" subdomains="false"/>
  <access origin="https://api.open-meteo.com" subdomains="false"/>
  <!-- background-support=enable keeps the launcher resident so the physical Home key
       foregrounds it instantly instead of a cold webview start. -->
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="enable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
